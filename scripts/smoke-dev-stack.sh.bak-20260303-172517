#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
DEV_STACK_SCRIPT="$ROOT_DIR/dev-stack.sh"

log() {
  echo "$*"
}

require_command() {
  local command_name=$1
  if ! command -v "$command_name" >/dev/null 2>&1; then
    log "MISSING: $command_name"
    return 1
  fi
}

main() {
  log "== dev-stack smoke checks =="

  require_command bash
  require_command ss
  require_command pgrep
  require_command pkill
  require_command curl
  require_command node
  require_command npm

  if [[ ! -x "$DEV_STACK_SCRIPT" ]]; then
    log "MISSING: executable script: $DEV_STACK_SCRIPT"
    exit 1
  fi

  log "1) Shell syntax check: $DEV_STACK_SCRIPT"
  bash -n "$DEV_STACK_SCRIPT"

  log "2) Preflight dry-run (start path)"
  "$DEV_STACK_SCRIPT" --dry-run --verbose start

  log "3) Help output"
  "$DEV_STACK_SCRIPT" --help

  if "$ROOT_DIR/frontend/node_modules/.bin/vite" --version >/dev/null 2>&1; then
    log "Vite binary: present"
  else
    log "WARN: frontend/node_modules/.bin/vite not found (run npm install in frontend)"
  fi

  log "Smoke checks complete"
}

main "$@"
