#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$SCRIPT_DIR"
BACKEND_DIR="$ROOT_DIR/backend"
FRONTEND_DIR="$ROOT_DIR/frontend"

BACKEND_PORT="8789"
FRONTEND_PORT="5173"
BACKEND_HOST="127.0.0.1"
FRONTEND_HOST="127.0.0.1"

BACKEND_LOG="$BACKEND_DIR/backend.log"
FRONTEND_LOG="$FRONTEND_DIR/frontend.log"

BACKEND_PATTERN="uvicorn app.main:app --host $BACKEND_HOST --port $BACKEND_PORT"
FRONTEND_PATTERN="vite --host $FRONTEND_HOST --port $FRONTEND_PORT"

BACKEND_HEALTH_URL="http://$BACKEND_HOST:$BACKEND_PORT/docs"
FRONTEND_HEALTH_URL="http://$FRONTEND_HOST:$FRONTEND_PORT/"

COMMAND="start"
DRY_RUN=false
VERBOSE=false
MAX_STARTUP_WAIT_SECONDS=60
CLEANUP_ON_EXIT=false
MANAGED_BACKEND_PID=""
MANAGED_FRONTEND_PID=""

log() {
  echo "$*"
}

verbose() {
  if [[ "$VERBOSE" == "true" ]]; then
    echo "[verbose] $*"
  fi
}

print_usage() {
  cat <<'EOF'
Usage:
  ./dev-stack.sh [--dry-run] [--verbose] {start|stop|restart|status|logs}

Commands:
  start    Start backend + frontend (default)
  stop     Stop backend + frontend started by matching command patterns
  restart  Stop then start
  status   Show listener + process status
  logs     Tail recent log lines from both services

Options:
  --dry-run   Print actions only (no side effects)
  --verbose   Print detailed steps
EOF
}

require_command() {
  local command_name=$1
  if ! command -v "$command_name" >/dev/null 2>&1; then
    log "Missing required command: $command_name"
    return 1
  fi
}

require_file() {
  local path=$1
  if [[ ! -e "$path" ]]; then
    log "Missing required file: $path"
    return 1
  fi
}

require_exec_file() {
  local path=$1
  if [[ ! -x "$path" ]]; then
    log "Missing required executable: $path"
    return 1
  fi
}

require_dir() {
  local path=$1
  if [[ ! -d "$path" ]]; then
    log "Missing required directory: $path"
    return 1
  fi
}

service_pids() {
  local pattern=$1
  pgrep -f "$pattern" 2>/dev/null || true
}

is_port_in_use() {
  local port=$1
  ss -ltnp 2>/dev/null | grep -qE ":${port}([[:space:]/]|$)"
}

warn_missing_file() {
  local path=$1
  local label=$2
  if [[ ! -e "$path" ]]; then
    verbose "Optional file missing for ${label}: $path"
  fi
}

wait_for_http() {
  local service_name=$1
  local url=$2
  local timeout=$3
  local attempts=$((timeout / 2))
  local attempts_left=$attempts
  local i

  if [[ "$DRY_RUN" == "true" ]]; then
    log "[dry-run] skip wait for ${service_name} readiness: $url"
    return 0
  fi

  while ((attempts_left > 0)); do
    if curl -fsS --max-time 2 "$url" >/dev/null 2>&1; then
      log "✓ $service_name is ready: $url"
      return 0
    fi
    verbose "Waiting for ${service_name} at ${url}... (${attempts_left}/${attempts})"
    sleep 2
    ((attempts_left--))
  done

  log "Timed out waiting for ${service_name} (${url})"
  return 1
}

ensure_ports_clear_for_start() {
  local port=$1
  local service=$2
  local existing_pid_count
  existing_pid_count=$(service_pids "${service}")
  if is_port_in_use "$port" && [[ -z "$existing_pid_count" ]]; then
    log "Port $port is in use by an unexpected process"
    ss -ltnp 2>/dev/null | grep -E ":${port}([[:space:]/]|$)" || true
    return 1
  fi
}

start_backend() {
  local existing_backend_pids
  existing_backend_pids=$(service_pids "$BACKEND_PATTERN")

  if [[ -n "$existing_backend_pids" ]]; then
    log "Backend already running (reusing): ${existing_backend_pids//$'\n'/, }"
    return 0
  fi

  if ! ensure_ports_clear_for_start "$BACKEND_PORT" "$BACKEND_PATTERN"; then
    return 1
  fi

  if [[ "$DRY_RUN" == "true" ]]; then
    log "Would start backend: nohup bash -lc \"cd '$BACKEND_DIR' && OVERMIND_DASHBOARD_PORT=$BACKEND_PORT ./run.sh\" >\"$BACKEND_LOG\" 2>&1 &"
    return 0
  fi

  CLEANUP_ON_EXIT=true
  verbose "Launching backend in background"
  nohup bash -lc "cd '$BACKEND_DIR' && OVERMIND_DASHBOARD_PORT=$BACKEND_PORT ./run.sh" >"$BACKEND_LOG" 2>&1 &
  MANAGED_BACKEND_PID=$!
  verbose "Backend started as pid ${MANAGED_BACKEND_PID}"

  if ! wait_for_http "backend" "$BACKEND_HEALTH_URL" "$MAX_STARTUP_WAIT_SECONDS"; then
    return 1
  fi
}

start_frontend() {
  local existing_frontend_pids
  existing_frontend_pids=$(service_pids "$FRONTEND_PATTERN")

  if [[ -n "$existing_frontend_pids" ]]; then
    log "Frontend already running (reusing): ${existing_frontend_pids//$'\n'/, }"
    return 0
  fi

  if ! ensure_ports_clear_for_start "$FRONTEND_PORT" "$FRONTEND_PATTERN"; then
    return 1
  fi

  if [[ "$DRY_RUN" == "true" ]]; then
    log "Would start frontend: nohup bash -lc \"cd '$FRONTEND_DIR' && npm run dev -- --host $FRONTEND_HOST --port $FRONTEND_PORT\" >\"$FRONTEND_LOG\" 2>&1 &"
    return 0
  fi

  CLEANUP_ON_EXIT=true
  verbose "Launching frontend in background"
  nohup bash -lc "cd '$FRONTEND_DIR' && npm run dev -- --host $FRONTEND_HOST --port $FRONTEND_PORT" >"$FRONTEND_LOG" 2>&1 &
  MANAGED_FRONTEND_PID=$!
  verbose "Frontend started as pid ${MANAGED_FRONTEND_PID}"

  if ! wait_for_http "frontend" "$FRONTEND_HEALTH_URL" "$MAX_STARTUP_WAIT_SECONDS"; then
    return 1
  fi
}

cleanup_managed_processes() {
  if [[ "$DRY_RUN" == "true" ]]; then
    return 0
  fi

  if [[ -n "$MANAGED_BACKEND_PID" ]]; then
    if kill -0 "$MANAGED_BACKEND_PID" >/dev/null 2>&1; then
      verbose "Cleaning backend pid ${MANAGED_BACKEND_PID}"
      kill -s TERM "$MANAGED_BACKEND_PID" || true
    fi
  fi

  if [[ -n "$MANAGED_FRONTEND_PID" ]]; then
    if kill -0 "$MANAGED_FRONTEND_PID" >/dev/null 2>&1; then
      verbose "Cleaning frontend pid ${MANAGED_FRONTEND_PID}"
      kill -s TERM "$MANAGED_FRONTEND_PID" || true
    fi
  fi

  sleep 1

  if [[ -n "$MANAGED_BACKEND_PID" ]] && kill -0 "$MANAGED_BACKEND_PID" >/dev/null 2>&1; then
    kill -s KILL "$MANAGED_BACKEND_PID" || true
  fi
  if [[ -n "$MANAGED_FRONTEND_PID" ]] && kill -0 "$MANAGED_FRONTEND_PID" >/dev/null 2>&1; then
    kill -s KILL "$MANAGED_FRONTEND_PID" || true
  fi
}

on_exit() {
  local rc=$?
  if [[ "${CLEANUP_ON_EXIT:-false}" == "true" ]]; then
    cleanup_managed_processes || true
  fi
  return "$rc"
}

start() {
  log "Starting development stack..."
  preflight_start
  if ! start_backend; then
    return 1
  fi
  if ! start_frontend; then
    return 1
  fi
  CLEANUP_ON_EXIT=false
  status
  echo ""
  echo "Frontend: ${FRONTEND_HEALTH_URL%/}"
  echo "Backend : http://$BACKEND_HOST:$BACKEND_PORT"
  echo "Backend docs: $BACKEND_HEALTH_URL"
}

stop_processes() {
  local pattern=$1
  local label=$2
  local pids
  pids=$(service_pids "$pattern")
  if [[ -z "$pids" ]]; then
    log "${label}: not running"
    return 0
  fi

  if [[ "$DRY_RUN" == "true" ]]; then
    log "Would stop ${label} processes: ${pids//$'\n'/, }"
    return 0
  fi

  log "Stopping ${label}..."
  while IFS= read -r pid; do
    if [[ -n "$pid" ]] && kill -0 "$pid" >/dev/null 2>&1; then
      kill -s TERM "$pid" || true
    fi
  done <<< "$pids"

  local attempts=0
  local remaining_pids
  while ((attempts < 10)); do
    remaining_pids=$(service_pids "$pattern")
    if [[ -z "$remaining_pids" ]]; then
      log "${label} stopped cleanly"
      return 0
    fi
    sleep 1
    ((attempts++))
  done

  log "${label} did not exit, escalating to SIGKILL"
  while IFS= read -r pid; do
    if [[ -n "$pid" ]] && kill -0 "$pid" >/dev/null 2>&1; then
      kill -s KILL "$pid" || true
    fi
  done <<< "$pids"
}

stop() {
  log "Stopping development stack..."
  stop_processes "$BACKEND_PATTERN" "backend"
  stop_processes "$FRONTEND_PATTERN" "frontend"
  sleep 1
  status
}

status() {
  echo ""
  echo "== Listening ports =="
  if command -v ss >/dev/null 2>&1; then
    ss -ltnp 2>/dev/null | grep ":$FRONTEND_PORT\|:$BACKEND_PORT\|:8787" || true
  else
    echo "ss unavailable; install iproute2 for port checks"
  fi

  echo ""
  echo "== Process matches =="
  pgrep -af "$BACKEND_PATTERN" || echo "backend: not running"
  pgrep -af "$FRONTEND_PATTERN" || echo "frontend: not running"
}

logs() {
  echo ""
  echo "--- backend log ($BACKEND_LOG) ---"
  tail -n 80 "$BACKEND_LOG" 2>/dev/null || echo "no backend log yet"
  echo ""
  echo "--- frontend log ($FRONTEND_LOG) ---"
  tail -n 80 "$FRONTEND_LOG" 2>/dev/null || echo "no frontend log yet"
}

preflight_start() {
  local ok=true
  require_command ss || ok=false
  require_command pgrep || ok=false
  require_command pkill || ok=false
  require_command curl || ok=false
  require_command node || ok=false
  require_command npm || ok=false

  require_dir "$BACKEND_DIR" || ok=false
  require_dir "$FRONTEND_DIR" || ok=false
  require_file "$BACKEND_DIR/run.sh" || ok=false
  require_exec_file "$BACKEND_DIR/run.sh" || ok=false
  require_file "$FRONTEND_DIR/package.json" || ok=false
  require_file "$BACKEND_DIR/.venv/bin/activate" || ok=false

  warn_missing_file "$FRONTEND_DIR/node_modules" "frontend dependencies"
  warn_missing_file "$BACKEND_DIR/.env" "backend env"
  warn_missing_file "$FRONTEND_DIR/.env" "frontend env"
  warn_missing_file "$BACKEND_DIR/.env.example" "backend env example"
  warn_missing_file "$FRONTEND_DIR/.env.example" "frontend env example"

  if [[ "$ok" != "true" ]]; then
    log "Preflight failed. Fix requirements and retry."
    return 1
  fi

  verbose "Preflight checks passed"
}

cleanup_signals() {
  cleanup_managed_processes || true
  exit 130
}

parse_args() {
  local command_set=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run)
        DRY_RUN=true
        ;;
      --verbose)
        VERBOSE=true
        ;;
      start|stop|restart|status|logs)
        if [[ "$command_set" == true ]]; then
          log "Only one command is allowed"
          print_usage
          exit 1
        fi
        COMMAND="$1"
        command_set=true
        ;;
      --help|-h|"")
        print_usage
        exit 0
        ;;
      *)
        log "Unknown argument: $1"
        print_usage
        exit 1
        ;;
    esac
    shift
  done

  if [[ "$DRY_RUN" == "true" && "$COMMAND" == "stop" ]]; then
    verbose "Dry-run mode is active; no process termination will occur."
  fi

  if [[ "$DRY_RUN" == "true" && "$COMMAND" == "logs" ]]; then
    verbose "Dry-run mode is active; logs are read-only and will be displayed."
  fi
}

run() {
  case "$COMMAND" in
    start)
      if ! start; then
        return 1
      fi
      ;;
    stop)
      stop
      ;;
    restart)
      stop
      start
      ;;
    status)
      status
      ;;
    logs)
      logs
      ;;
    *)
      print_usage
      exit 1
      ;;
  esac
}

trap on_exit EXIT
trap cleanup_signals INT
trap cleanup_signals TERM

parse_args "$@"
run
